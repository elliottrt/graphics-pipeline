		(Color, float) IntersectWithRay(V3 O, V3 r):
			Color closest_color = BLACK
			float closest_t = infinity // or FLT_MAX
			foreach mesh in meshes:
				float color
				float t

				if IntersectWithMesh(O, r, color, t) && t < closest_t:
					closest_t = t
					closest_color = color
			return (closest_color, closest_t)
		bool IntersectWithMesh(V3 O, V3 r, V3 &color, float &t):
			float closest_t = infinity
			vec3 closest_color = none

			for tri in this:
				matrix M = matrix from columns(tri.v0, tri.v1, tri.v2)
				matrix Minv = inverse of M

				vec3 Q0 = Minv * O
				vec3 Q1 = Minv * r
				t = (1 - (Q0x + Q0y + Q0z)) / (Q1x + Q1y + Q1z)

				if t < 0
					continue

				// compute barycentric coordinates
				// abc is an out parameter, so the caller has its value
				vec3 abc = Q0 + Q1 * t

				if any(abc < 0)
					continue
				else
					if t < closest_t
						closest_t = t
						closest_color = tri.v0.color * abc.a + tri.v1.color * abc.b + tri.v2.color * abc.c
						tex_coords = tri.v0.tx * abc.a * ...

			t = closest_t
			color = closest_color
			return closest_t != infinity